{
  "name": "bbb-plugin-live-transcription",
  "version": "0.0.3",
  "private": false,
  "main": "./src/index.tsx",
  "dependencies": {
    "babel-plugin-syntax-dynamic-import": "^6.18.0",
    "bigbluebutton-html-plugin-sdk": "0.0.94",
    "path": "^0.12.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intl": "^6.6.8",
    "styled-components": "^5.3.3"
  },
  "scripts": {
    "build-bundle": "webpack --mode production",
    "start": "webpack serve --mode development",
    "build:watch": "rm -rf dist && tsc -w --module CommonJS",
    "lint": "eslint ./src/*",
    "lint:fix": "npm run lint -- --fix",
    "lint:watch": "watch 'yarn lint'",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "publish-plugin:dev": "bash scripts/copy-plugin-to-container.sh",
    "test": "playwright test",
    "test-chromium-ci": "CI=true playwright test --project=chromium"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.21.8",
    "@babel/preset-env": "^7.21.5",
    "@babel/preset-react": "^7.18.6",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^13.4.0",
    "@types/node": "^20.4.4",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/styled-components": "^5.1.26",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.6",
    "babel-loader": "^9.1.2",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.7.4",
    "dotenv": "^16.6.1",
    "eslint": "^8.45.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-watch": "^8.0.0",
    "jsdom": "^25.0.1",
    "lint-staged": "11.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.6",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "watch": "^0.13.0",
    "webpack": "^5.83.1",
    "webpack-cli": "^5.1.1",
    "webpack-dev-server": "^5.2.2"
  }
}
